{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "BufferPath": "data/buffer.db",
    "Collectors": [
      {
        "Id": "sim-press-01",
        "Type": "simulator",
        "IntervalSeconds": 2,
        "Settings": {
          "temperature": "180..220",
          "pressure": "80..120",
          "count": "counter"
        }
      }
    ],
    "Sender": {
      "Type": "console",
      "IntervalSeconds": 5,
      "BatchSize": 500,
      "Settings": {
        "Url": "",
        "ApiKey": "",
        "TimeoutSeconds": "10"
      }
    }
  }
}
